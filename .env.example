# ===== Database =====
POSTGRES_USER=kmg_user
POSTGRES_PASSWORD=<PASSWORD>
POSTGRES_DB=kmg_security
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql://kmg_user:<PASSWORD>@localhost:5432/kmg_security

# ===== NestJS =====
PORT=3000
NODE_ENV=development

# ===== JWT =====
JWT_SECRET=<JWT_SECRET>
JWT_EXPIRES_IN=7d

# ===== GitHub OAuth =====
GITHUB_CLIENT_ID=<GITHUB_CLIENT_ID>
GITHUB_CLIENT_SECRET=<GITHUB_CLIENT_SECRET>
GITHUB_CALLBACK_URL=http://localhost:3000/api/auth/github/callback
# On logout, revoke the whole OAuth grant (not just the token) so the next login
# performs a full GitHub authorization instead of silently reusing the old one.
GITHUB_REVOKE_GRANT_ON_LOGOUT=true

# ===== Groq AI =====
# Main pool: comma/newline-separated keys (or a JSON array). Invalid, rate
# limited, and temporarily unavailable keys are skipped automatically.
# Keep real values only in .env / your secret manager; never commit them.
GROQ_API_KEYS=<GROQ_API_KEY_1>,<GROQ_API_KEY_2>
# Backward-compatible fallback for one installation key.
GROQ_API_KEY=<GROQ_API_KEY>
# Must be a model the account can actually use AND that supports tool calling.
# Check availability: GET https://api.groq.com/openai/v1/models
GROQ_MODEL=openai/gpt-oss-120b
# Per-key temporary cooldown and startup key probe timeout.
GROQ_KEY_COOLDOWN_MS=15000
GROQ_KEY_PROBE_TIMEOUT_MS=5000

# ===== AI investigation =====
# The investigation runs as many small independent calls rather than one growing
# transcript, so it fits inside the account's tokens-per-minute budget.
AI_TRIAGE_MAX_FINDINGS=0       # 0 = individual AI verdict for every finding
AI_TRIAGE_BATCH_SIZE=3         # findings analysed per model call
AI_RECON_ENABLED=false         # optional free-form repository recon pass
AI_RECON_ITERATIONS=3

# ===== Security Engine =====
SECURITY_ENGINE_URL=http://localhost:8000
# Full scan of a real repository (semgrep + gitleaks + trivy) can take minutes.
SECURITY_ENGINE_TIMEOUT_MS=600000
# Pre-push checks look at a diff only, so they get a shorter budget.
PREPUSH_ENGINE_TIMEOUT_MS=300000

# Local Semgrep rule sets used on every scan (KMG baseline + the official
# open-source security rules bundled into the image). Comma separated.
SEMGREP_RULES_DIRS=/app/rules,/opt/semgrep-rules
# Extra Semgrep rulesets on top of the bundled ones (e.g. "auto" or "p/default").
# Empty by default: registry rules require network access on every scan.
SEMGREP_REGISTRY_CONFIG=
# Per-scanner limits inside the security engine (seconds)
SEMGREP_TIMEOUT_SECONDS=300
GITLEAKS_TIMEOUT_SECONDS=180
TRIVY_TIMEOUT_SECONDS=300

# ===== Frontend =====
FRONTEND_URL=http://localhost:5173

# ===== Encryption =====
ENCRYPTION_KEY=<32_CHAR_ENCRYPTION_KEY>

# ===== Pre-push guard =====
# Body limit for /api/prepush/check (the hook uploads the files being pushed)
# Полный проект в режиме ci: до 30 МБ сырых данных = ~40 МБ в base64, поэтому лимит тела 45mb.
API_BODY_LIMIT=45mb

# ===== CI/CD интеграция =====
# Подпись GitHub webhook (Settings -> Webhooks -> Secret)
GITHUB_WEBHOOK_SECRET=
# Ветки, для которых push запускает автоматический скан
CICD_BRANCHES=main,master,develop

# ===== CI: приём архива кода из GitHub Actions =====
# Лимит тела запроса на уровне express для /api/ci/scan
CI_ARCHIVE_LIMIT=80mb
# Лимит размера архива в сервисе (байты)
CI_MAX_ARCHIVE_BYTES=83886080

# ===== DB (docker-compose) =====
# Пароль БД для docker compose. Задайте ДО первого запуска: смена после
# инициализации тома pgdata не применяется.
DB_PASSWORD=<PASSWORD>

# ===== Агент: время и объём (ТЗ п. 4.7) =====
# Внутренний бюджет времени шага проверки, мс. Должен быть меньше timeout-minutes
# job-а: по его исчерпании агент формирует отчёт «проверка не выполнена» и
# возвращает код 2, а не ждёт принудительного завершения job-а.
KMG_TIME_BUDGET_MS=1500000
# Бюджет AI-этапа на стороне backend, мс. По исчерпании AI-анализ пропускается,
# детерминированный вердикт по требованиям ИБ от него не зависит.
AI_STAGE_BUDGET_MS=480000
# Общий секрет backend ↔ security-engine (заголовок X-Engine-Token). Сгенерируйте:
#   openssl rand -hex 32
# Пусто = открытый режим движка (только для локальной разработки).
ENGINE_TOKEN=<ENGINE_TOKEN>
# Ограничения контейнера security-engine
ENGINE_MEM_LIMIT=4g
ENGINE_CPUS=2
